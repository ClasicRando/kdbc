#!/bin/bash

jdbcPgConnectionString="${JDBC_PG_CONNECTION_STRING}"
if [[ -z "${jdbcPgConnectionString}" ]]; then
  read -s -p "Postgres JDBC Connection String: " jdbcPgConnectionString
  echo ""
  export JDBC_PG_CONNECTION_STRING="$jdbcPgConnectionString"
fi

pgBenchmarkPassword="${PG_BENCHMARK_PASSWORD}"
if [[ -z "${pgBenchmarkPassword}" ]]; then
  read -s -p "Postgres Password: " pgBenchmarkPassword
  echo ""
  export PG_BENCHMARK_PASSWORD="$pgBenchmarkPassword"
fi

jdbcMySqlConnectionString="${JDBC_MYSQL_CONNECTION_STRING}"
if [[ -z "${jdbcMySqlConnectionString}" ]]; then
  read -s -p "MySQL JDBC Connection String: " jdbcMySqlConnectionString
  echo ""
  export JDBC_MYSQL_CONNECTION_STRING="$jdbcMySqlConnectionString"
fi

mysqlBenchmarkPassword="${MYSQL_BENCHMARK_PASSWORD}"
if [[ -z "${mysqlBenchmarkPassword}" ]]; then
  read -s -p "MySQL Password: " mysqlBenchmarkPassword
  echo ""
  export MYSQL_BENCHMARK_PASSWORD="$mysqlBenchmarkPassword"
fi

./gradlew benchmarks:jmh
